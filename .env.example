# LLM API Keys
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Optional: Custom API Base URL
# LLM_API_BASE_URL=https://api.openai.com/v1

# Optional: Speech-to-Text (ASR) Configuration
# ASR_BACKEND=sensevoice          # "sensevoice" (default, ~230MB int8 ONNX) or "faster-whisper"
# ASR_WHISPER_MODEL=large-v3-turbo # Used when ASR_BACKEND=faster-whisper (e.g. "large-v3-turbo", "small", "base")
# ASR_DEVICE=auto                 # "auto", "cpu", "cuda", or "coreml"
# ASR_COMPUTE_TYPE=int8           # "int8", "float16", "int8_float16"

